# ============================================================
# 惠福星链 · Slim Runtime Dockerfile
# 不需要 Maven 编译，直接运行预构建的 jar
# 用法: 先在本地 mvn package，然后 docker compose --profile full build
# ============================================================
FROM eclipse-temurin:21-jre-alpine
LABEL maintainer="huifu-starchain"

RUN addgroup -S huifu && adduser -S huifu -G huifu
RUN apk add --no-cache curl tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app
COPY target/*.jar app.jar

RUN mkdir -p /var/log/huifu-starchain && chown -R huifu:huifu /app /var/log/huifu-starchain

USER huifu
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/api/v1/health || exit 1

ENTRYPOINT ["java", \
    "-Xms256m", "-Xmx1g", \
    "-XX:+UseZGC", \
    "-Djava.security.egd=file:/dev/./urandom", \
    "-Dspring.profiles.active=prod", \
    "-jar", "/app/app.jar"]
